# =============================================================================
# .env.production.example — template for production deployment.
#
# Copy this file to:
#   - deploy/.env.production  (for local docker compose -f deploy/docker-compose.prod.yml)
#   - Coolify environment variables (paste each KEY=VALUE pair into the UI)
#
# Lines marked REQUIRED must be filled. Lines marked OPTIONAL can be left as-is
# or removed if you don't need that feature.
# =============================================================================

# ---------------- DATABASE ---------------- (REQUIRED)
# In docker-compose.prod.yml this is overridden to point at the postgres service.
# In Coolify, set this to the connection string of the Coolify-managed postgres,
# e.g. postgresql://USER:PWD@HOST:5432/DBNAME?options=-c search_path=public,bilan_carbone,common
POSTGRES_PRISMA_URL=postgresql://bilancarbone:bilancarbone@postgres:5432/bilancarbone?options=-c search_path=public,bilan_carbone,common

# ---------------- AUTH (NextAuth) ---------------- (REQUIRED)
# Generate a secret: openssl rand -base64 32
NEXTAUTH_SECRET=CHANGE_ME_OPENSSL_RAND_BASE64_32
# Public URL of the app. Update this when you switch from IP to domain.
# IP-only test:   http://YOUR_VPS_IP
# Production:     https://abc.santiago.contact
NEXTAUTH_URL=https://abc.santiago.contact

# ---------------- ADMIN BOOTSTRAP ---------------- (REQUIRED)
# Used by the seed to create the first admin account.
ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# ---------------- NODE ----------------
NODE_ENV=production
NO_CACHE=true

# ---------------- MAIL (BC+) ----------------
# In docker-compose.prod.yml these are overridden to point at maildev.
# For real production: SMTP server (e.g. SendGrid, Mailjet, Gmail SMTP).
MAIL_USER=user@email.com
MAIL_PASSWORD=changeme
MAIL_HOST=maildev
MAIL_PORT=1025
CONTACT_EMAIL=contact@associationbilancarbone.fr
CONTACT_FORM_URL=https://abc-transitionbascarbone.fr/contact-et-hotline

# ---------------- MAIL (CUT/Cap Carbone) ----------------
CUT_MAIL_USER=user@email.com
CUT_MAIL_PASSWORD=changeme
CUT_MAIL_HOST=maildev
CUT_MAIL_PORT=1025
CUT_CONTACT_FORM_URL=https://abc-transitionbascarbone.fr/contact-et-hotline

# ---------------- PUBLIC LINKS (visible in browser) ----------------
NEXT_PUBLIC_SUPPORT_EMAIL=support@abc-transitionbascarbone.fr
NEXT_PUBLIC_CUT_SUPPORT_EMAIL=support@abc-transitionbascarbone.fr
NEXT_PUBLIC_CLICKSON_SUPPORT_EMAIL=pebc@clickson.eu
NEXT_PUBLIC_FAQ_LINK=https://abc-transitionbascarbone.fr/faq
NEXT_PUBLIC_CUT_FAQ_LINK=https://abc-transitionbascarbone.fr/faq
NEXT_PUBLIC_ABC_SITE=https://abc-transitionbascarbone.fr/
NEXT_PUBLIC_FORMATION_URL=https://abc-transitionbascarbone.fr/agir/se-former-au-bilan-carbone/
NEXT_PUBLIC_ACTORS_URL=https://abc-transitionbascarbone.fr/les-acteurs/annuaire-des-prestataires/
NEXT_PUBLIC_SNBC_URL=https://www.ecologie.gouv.fr/politiques-publiques/strategie-nationale-bas-carbone-snbc
NEXT_PUBLIC_SBTI_URL=https://sciencebasedtargets.org/net-zero
NEXT_PUBLIC_LICENSE_RENEWAL_LINK=https://abc-transitionbascarbone.fr/agir/adherer-a-labc
NEXT_LICENSE_RENEWAL_MONTH_START=12
NEXT_LICENSE_RENEWAL_MONTH_END=2
NEXT_PUBLIC_GHGP_ACTIVATION_DATE=2026-03-12
MEMBERSHIP_BLOCKING_DATE=15/02
NEXT_PUBLIC_TYPEFORM_DEPLACEMENTS_LINK=https://typeform.com/placeholder
NEXT_PUBLIC_SBTI_DOC_URL=https://sciencebasedtargets.org
NEXT_PUBLIC_SNBC_DOC_URL=https://www.ecologie.gouv.fr/strategie-nationale-bas-carbone-snbc

# ---------------- FE SOURCES ----------------
BC_FE_SOURCES_IMPORT=BaseEmpreinte,Legifrance,NegaOctet,Manual,AIB
TILT_FE_SOURCES_IMPORT=BaseEmpreinte,Legifrance,NegaOctet,Manual,AIB
CUT_FE_SOURCES_IMPORT=BaseEmpreinte,Legifrance,CUT
CLICKSON_FE_SOURCES_IMPORT=BaseEmpreinte

# ---------------- STORAGE (Scaleway S3) ---------------- (OPTIONAL — features broken without)
# Without these, file uploads / PDF templates / Excel templates won't work.
# For initial functional testing, leave as placeholders.
SCW_ACCESS_KEY=placeholder
SCW_SECRET_KEY=placeholder
SCW_BUCKET_NAME=placeholder
SCW_REGION=fr-par
STUDY_FLOW_EXAMPLE_KEY=placeholder
DEPENDENCY_MATRIX_EXAMPLE_KEY=placeholder
SCW_CUT_METHOD_KEY=methodologie_count.pdf
SCW_RESILIO_METHOD_KEY=methodologie_resilio.pdf
SCW_REPORT_TEMPLATE_KEY=report_template.docx
SCW_EF_TEMPLATE_KEY=emission-factors-template.xlsx

# ---------------- PDF SERVICE ---------------- (OPTIONAL)
# Point to your Gotenberg instance if you have one (you do, per STACK-KOZEO.md).
PDF_SERVICE_URL=http://gotenberg:3000
PDF_SERVICE_API_SECRET=placeholder
PDF_JWT_SECRET=CHANGE_ME_OPENSSL_RAND_BASE64_32

# ---------------- INSEE / SCHOOLS ----------------
INSEE_SERVICE_URL=https://api.insee.fr/api-sirene/3.11/siret/
INSEE_API_SECRET=placeholder
SCHOOL_API_URL=https://data.education.gouv.fr/api/explore/v2.1/catalog/datasets/fr-en-annuaire-education/records

# ---------------- FTP IMPORTS ---------------- (OPTIONAL)
# Used by the cron that imports users from a partner FTP. Leave placeholder
# unless you actually want to enable user sync.
FTP_HOST=placeholder
FTP_USER=placeholder
FTP_PASSWORD=placeholder
FTP_FILE_NAME=users.json
FTP_FILE_PATH=/
FTP_PORT=21

# ---------------- CRON ----------------
NEXT_API_URL=https://abc.santiago.contact/api
CRON_SECRET=CHANGE_ME_RANDOM_TOKEN

# ---------------- TYPEFORM ---------------- (OPTIONAL)
NEXT_PUBLIC_FORMATION_TYPEFORM_ID=placeholder
NEXT_PUBLIC_FORMATION_TYPEFORM_DURATION=3600000
NEXT_PUBLIC_FEEDBACK_TYPEFORM_ID=placeholder
NEXT_PUBLIC_CUT_FEEDBACK_TYPEFORM_ID=172800000
NEXT_PUBLIC_CUT_FEEDBACK_TYPEFORM_LINK=172800000

# ---------------- FE VERSIONS ----------------
CUT_FE_LEGIFRANCE_VERSION=
CUT_FE_BASE_EMPREINTE_VERSION=

# ---------------- TEMPLATE ORG ----------------
# Set after first deploy: ID of the organization that holds duplicable studies.
STUDY_TEMPLATE_ORGANIZATION_ID=

# ---------------- ENTRYPOINT FLAGS ----------------
# Set RUN_SEED=true on first deploy only, then unset.
RUN_MIGRATIONS=true
RUN_SEED=false
